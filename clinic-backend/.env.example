# Copy to .env for local overrides. Never commit real credentials.
DB_URL=jdbc:postgresql://localhost:5433/clinic_db
DB_USERNAME=clinic_user
DB_PASSWORD=clinic_pass
SERVER_PORT=8080

# JWT signing secret. Must be at least 32 characters (HMAC-SHA256).
# Generate a fresh one per environment; never reuse the dev fallback.
CLINIC_JWT_SECRET=dev-only-secret-change-me-in-every-real-environment
CLINIC_JWT_ACCESS_SECONDS=3600
CLINIC_JWT_REFRESH_SECONDS=604800
